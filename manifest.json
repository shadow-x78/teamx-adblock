{
  "manifest_version": 3,
  "name": "TeamX - AdBlock",
  "version": "1.3.0",
  "description": "Comprehensive ad, banner, and popup blocker engineered exclusively for Olympus Staff (olympustaff.com)",
  "author": "shadow-x78",
  "homepage_url": "https://github.com/shadow-x78/teamx-adblock",
  "update_url": "https://raw.githubusercontent.com/shadow-x78/teamx-adblock/main/updates.xml",
  "browser_specific_settings": {
    "gecko": {
      "id": "teamx-adblock@shadow-x78",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TeamX - AdBlock"
  },
  "content_scripts": [
    {
      "matches": [
        "https://olympustaff.com/*",
        "https://*.olympustaff.com/*"
      ],
      "css": [
        "rules.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
