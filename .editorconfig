# ─────────────────────────────────────────────
# TeamX - Ads Block - Editor Configuration
# https://github.com/shadow-x78/teamx-adsblock
# ─────────────────────────────────────────────

# ── Root ──
root = true

# ── Defaults ──
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# ── JavaScript / JSON ──
[*.{js,json}]
indent_size = 2

# ── Markdown ──
[*.md]
trim_trailing_whitespace = false
